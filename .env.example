# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# --- Cloud fallback LLM ---
# Used for complex architectural/security analysis that the local
# model isn't confident about (see core/model_router.py)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Routing behavior ---
# "auto"  -> local model attempts first, escalates to cloud on low confidence
# "local" -> force local only (fully offline / free)
# "cloud" -> force cloud only (max quality, for demo day)
ROUTING_MODE=auto

# --- Vector DB (RAG) ---
QDRANT_MODE=local          # "local" = on-disk, "server" = running Qdrant container
QDRANT_PATH=./qdrant_data
QDRANT_URL=http://localhost:6333

# --- GitHub webhook ---
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
# Optional root containing checked-out repositories keyed by repository name.
GITHUB_REPOSITORY_ROOT=

# --- Sandbox (auto-debug loop) ---
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=60
